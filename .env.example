APP_NAME="GODRAM Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development uses SQLite. On WhoGoHost, switch to the MySQL database you create in DirectAdmin:
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=youruser_godram
# DB_USERNAME=youruser_godram
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Email and push notifications wait in the database queue; cron sends them every minute.
NOTIFY_QUEUE=database

# Phone and browser notifications. Run: php artisan godram:push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GODRAM settings
GODRAM_MEMBER_PREFIX=GDM-
GODRAM_YOUTUBE_URL=https://www.youtube.com/@GODRAMTV
GODRAM_YOUTUBE_CHANNEL_ID=UCRJnL2sj9MASfswKg9Sle1A
GODRAM_FACEBOOK_URL=https://www.facebook.com/share/1HdrHtq6gz/
GODRAM_WHATSAPP_URL=
# true shows the "sample data" banner and the demo sign-in list. Turn off for real use.
GODRAM_DEMO_MODE=false
